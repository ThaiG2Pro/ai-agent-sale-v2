# Database Configuration
DB_USER=user
# DB_PASSWORD is intentionally left blank to encourage using Docker secrets.
# Create a secret file at ./secrets/db_password.txt and populate it with the DB password.
# For Docker Compose, mount this as secret `db_password` and keep DB_PASSWORD empty.
DB_PASSWORD=
DB_NAME=ai_agent
DB_HOST=localhost
DB_PORT=5432
API_PORT=8000
# DATABASE_URL_PSYCOPG=postgresql://user:password@localhost:5432/ai_agent
# Async SQLAlchemy DSN format (optional explicit override if needed):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Admin Configuration
X_ADMIN_KEY=your_secret_admin_key_here

# ══════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE PROFILES (Choose 1 Profile by uncommenting its variables)
# ══════════════════════════════════════════════════════════════════════════════

# ── PROFILE 1: 100% Offline Ollama (Zero Cost / 0 VND / CPU & GPU) ─────────────
# CHAT_MODEL=ollama/qwen3-4b-q6:latest
# LIGHT_CHAT_MODEL=ollama/qwen3-1.7b:latest
# POWERFUL_CHAT_MODEL=ollama/qwen3-4b-q6:latest
# PREMIUM_MODEL=ollama/qwen3-4b-q6:latest
# EMBED_MODEL=ollama/bge-m3
# EMBED_DIMENSION=1024
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_BASE_URL=http://localhost:11434

# ── PROFILE 2: Local llama-server (llama.cpp ROCm HIP / CUDA / Vulkan) ─────────
# LLAMA_SERVER_BASE_URL=http://localhost:8080/v1
# CHAT_MODEL=hosted_vllm/economy-chat
# LIGHT_CHAT_MODEL=hosted_vllm/light-chat
# POWERFUL_CHAT_MODEL=hosted_vllm/economy-chat
# PREMIUM_MODEL=hosted_vllm/economy-chat
# EMBED_MODEL=ollama/bge-m3
# EMBED_DIMENSION=1024

# ── PROFILE 3: Cloud Hybrid (Groq High-Speed Chat + Local Ollama Embedding) ────
# CHAT_MODEL=groq/llama-3.3-70b-versatile
# LIGHT_CHAT_MODEL=groq/llama-3.1-8b-instant
# POWERFUL_CHAT_MODEL=groq/llama-3.3-70b-versatile
# PREMIUM_MODEL=groq/llama-3.3-70b-versatile
# EMBED_MODEL=ollama/bge-m3
# EMBED_DIMENSION=1024
# GROQ_API_KEY=gsk_your_groq_api_key_here
# Proactive client-side RPM throttle (2026-22-8 report §4.3): Groq free tier
# allows 30 RPM — 28 leaves headroom so 429s never fire. 0 = disabled (local).
# LLM_RPM_LIMIT=28

# ── PROFILE 4: Full Cloud (Gemini / OpenAI / OpenRouter / Anthropic) ───────────
# CHAT_MODEL=gemini/gemini-2.5-flash
# LIGHT_CHAT_MODEL=gemini/gemini-2.5-flash
# POWERFUL_CHAT_MODEL=gemini/gemini-2.5-pro
# PREMIUM_MODEL=gemini/gemini-2.5-pro
# EMBED_MODEL=openai/text-embedding-3-small
# EMBED_DIMENSION=1536
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Active Configuration (Default: Profile 1 Offline Ollama)
CHAT_MODEL=ollama/qwen3-4b-q6:latest
LIGHT_CHAT_MODEL=ollama/qwen3-1.7b:latest
POWERFUL_CHAT_MODEL=ollama/qwen3-4b-q6:latest
PREMIUM_MODEL=ollama/qwen3-4b-q6:latest
EMBED_MODEL=ollama/bge-m3
EMBED_DIMENSION=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_BASE_URL=http://localhost:11434
LLAMA_SERVER_BASE_URL=http://localhost:8080/v1

# Cloud API Keys (populated when using Profiles 3 & 4)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=

# Semantic cache TTL in seconds (entries older than this are ignored;
# 0 = never expire). Cache is also fully invalidated on product ingest.
CACHE_TTL_SECONDS=3600

# Logging & Observability
LOG_LEVEL=INFO
LOGFIRE_TOKEN=
# Running the app on the host: localhost:4317 (Phoenix container's mapped port).
# Running via docker compose: leave unset — compose overrides to http://phoenix:4317.
OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-sales-agent
# Phoenix UI project the traces appear under (http://localhost:6006)
PHOENIX_PROJECT_NAME=ai-sales-agent
# WP-V3-2: Enable per-node OpenTelemetry spans during LangGraph execution (false = kill-switch)
OTEL_NODE_SPANS_ENABLED=true


# Week 3: Agent Configuration
RERANKER_ENABLED=false
AGENT_MAX_TURNS=5
AGENT_CONFIDENCE_THRESHOLD=0.70
AGENT_ALPHA=0.7
PREMIUM_MODEL=premium-chat
RAG_RETRY_MAX_ATTEMPTS=1  # 0 = kill switch, max 2

# WP-V2-1: Groundedness self-check + cascade verification
# GROUNDEDNESS_CHECK_ENABLED=false → kill switch (pre-check behavior, no extra LLM calls)
# GROUNDEDNESS_MAX_REGEN: strict-prompt regenerations before declining (0-2)
# CASCADE_VERIFY_ENABLED: COMPLAINT/NEGOTIATION answer on economy tier first,
#   PREMIUM_MODEL only when the groundedness verdict fails (needs check enabled)
GROUNDEDNESS_CHECK_ENABLED=true
GROUNDEDNESS_MAX_REGEN=1
CASCADE_VERIFY_ENABLED=true

# WP-V2-3: Clarify loop + LLM query decomposition
# CLARIFY_ENABLED=false → borderline queries decline as pre-V2-3 (kill switch)
# QUERY_DECOMPOSITION_ENABLED=false → COMPARISON regex split only (kill switch)
CLARIFY_ENABLED=true
QUERY_DECOMPOSITION_ENABLED=true

# WP-V2-4: Episodic memory + risk-score HITL tiers
# EPISODIC_MEMORY_ENABLED=false → semantic memory only, no per-turn event log (kill switch)
# RISK_HITL_ENABLED=false → pre-V2-4 binary HITL triggers (kill switch)
# Safety invariant (hardcoded): ORDER_PLACEMENT above HITL_HIGH_VALUE_ORDER_THRESHOLD
# (or with unknown order value) is ALWAYS human-reviewed — weights cannot override it.
EPISODIC_MEMORY_ENABLED=true
EPISODIC_RECENT_LIMIT=5
RISK_HITL_ENABLED=true
HITL_RISK_W_CONF=0.4
HITL_RISK_W_VALUE=0.4
HITL_RISK_W_HISTORY=0.2
HITL_RISK_TIER1_THRESHOLD=0.35
HITL_RISK_TIER3_THRESHOLD=0.75
HITL_ORDER_VALUE_NORM_CAP=20000000
HITL_HIGH_VALUE_ORDER_THRESHOLD=5000000

# WP-V2-5: Cost dashboard + budget guard + cheap-intent routing
# DAILY_COST_LIMIT_USD > 0 → today's cost at/over limit forces light-chat (never blocks)
# CUSTOMER_DAILY_MSG_CAP > 0 → per-customer daily LLM-call cap (polite come-back message)
# Both default 0 = off (local Ollama is free); set when using cloud provider keys.
# CHEAP_INTENT_LIGHT_ROUTING=false → SMALLTALK stays on economy-chat (pre-V2-5)
DAILY_COST_LIMIT_USD=0
CUSTOMER_DAILY_MSG_CAP=0
CHEAP_INTENT_LIGHT_ROUTING=true

# Week 4: HITL Configuration
HITL_TIMEOUT_WARN_MIN=30
HITL_TIMEOUT_ESCALATE_MIN=60
HITL_MAX_ESCALATION_COUNT=2
HITL_PRICE_DELTA_THRESHOLD=0.05
HITL_CLASSIFY_CONFIDENCE_THRESHOLD=0.6
HITL_COST_THRESHOLD_TOKENS=8000
SUPPORT_CONTACT_LINK=https://t.me/support_bot

# Week 6: Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_min_20_chars_random_string
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram
TOOL_TIMEOUT_DEFAULT=5
TOOL_TIMEOUT_INVENTORY_CHECK=5
TOOL_TIMEOUT_ORDER_PROCESSING=10
