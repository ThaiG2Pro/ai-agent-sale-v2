# Database Configuration
DB_USER=user
# DB_PASSWORD is intentionally left blank to encourage using Docker secrets.
# Create a secret file at ./secrets/db_password.txt and populate it with the DB password.
# For Docker Compose, mount this as secret `db_password` and keep DB_PASSWORD empty.
DB_PASSWORD=
DB_NAME=ai_agent
DB_HOST=localhost
DB_PORT=5432
API_PORT=8000
# DATABASE_URL_PSYCOPG=postgresql://user:password@localhost:5432/ai_agent
# Async SQLAlchemy DSN format (optional explicit override if needed):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Admin Configuration
X_ADMIN_KEY=your_secret_admin_key_here

# AI Configuration (LiteLLM / Ollama)
# When running the api inside docker compose, use:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=ollama/qwen3-4b-q6
EMBED_MODEL=ollama/bge-m3

# ── Cloud provider option (LiteLLM fast-path, no Ollama needed for chat) ──
# Model settings accept ANY LiteLLM model string; LiteLLM reads the matching
# provider API key straight from the environment. Examples:
#   LIGHT_CHAT_MODEL=gemini/gemini-2.5-flash
#   CHAT_MODEL=gemini/gemini-2.5-flash
#   POWERFUL_CHAT_MODEL=gemini/gemini-2.5-pro
#   CHAT_MODEL=gpt-4o-mini              (needs OPENAI_API_KEY)
# Recommended default: chat = cloud, embed = LOCAL Ollama bge-m3.
# ⚠️ Embedding dimension constraint: pgvector columns are Vector(1024)
#   (bge-m3). Only switch EMBED_MODEL to a model that supports
#   dimensions=1024 (e.g. OpenAI text-embedding-3-large with
#   dimensions=1024); otherwise keep EMBED_MODEL=ollama/bge-m3.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Semantic cache TTL in seconds (entries older than this are ignored;
# 0 = never expire). Cache is also fully invalidated on product ingest.
CACHE_TTL_SECONDS=3600

# Logging & Observability
LOG_LEVEL=INFO
LOGFIRE_TOKEN=
OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-sales-agent

# Week 3: Agent Configuration
RERANKER_ENABLED=false
AGENT_MAX_TURNS=5
AGENT_CONFIDENCE_THRESHOLD=0.70
AGENT_ALPHA=0.7
PREMIUM_MODEL=premium-chat

# Week 4: HITL Configuration
HITL_TIMEOUT_WARN_MIN=30
HITL_TIMEOUT_ESCALATE_MIN=60
HITL_MAX_ESCALATION_COUNT=2
HITL_PRICE_DELTA_THRESHOLD=0.05
HITL_CLASSIFY_CONFIDENCE_THRESHOLD=0.6
HITL_COST_THRESHOLD_TOKENS=8000
SUPPORT_CONTACT_LINK=https://t.me/support_bot

# Week 6: Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_min_20_chars_random_string
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhooks/telegram
TOOL_TIMEOUT_DEFAULT=5
TOOL_TIMEOUT_INVENTORY_CHECK=5
TOOL_TIMEOUT_ORDER_PROCESSING=10
